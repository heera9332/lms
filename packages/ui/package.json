{
  "name": "@lms/ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\""
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.82.0",
    "next-themes": "^0.4.6",
    "shadcn": "^4.23.1",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@lms/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tailwindcss": "^4.3.5",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.56.0"
  }
